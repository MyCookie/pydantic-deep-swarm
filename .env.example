# Portable Agent Team deployment defaults.
# Copy to an ignored .env or inject these values through the service supervisor.

# Core runtime paths; do not copy machine-local values into Git.
AGENT_TEAM_PROJECT_ROOT=${AGENT_TEAM_PROJECT_ROOT:-.}
AGENT_TEAM_HOME=${AGENT_TEAM_HOME:-$HOME}
AGENT_TEAM_STATE_DIR=${AGENT_TEAM_STATE_DIR:-$AGENT_TEAM_HOME/.agent-team}
AGENT_TEAM_SUPERVISOR=none
AGENT_TEAM_HOST=localhost
AGENT_TEAM_PORT=8080

# Optional s6 deployment: set AGENT_TEAM_SUPERVISOR=s6 and supply these paths.
# AGENT_TEAM_VENV=... external virtual environment
# AGENT_TEAM_PYTHON=${AGENT_TEAM_VENV}/bin/python
# AGENT_TEAM_SERVICE_USER=agent-team
# AGENT_TEAM_SERVICE_DIR=... live supervised service directory
# AGENT_TEAM_LIVE_RUNFILE=${AGENT_TEAM_SERVICE_DIR}/run
# AGENT_TEAM_SERVICE_DEFINITION=... installed service definition
# AGENT_TEAM_LOG_PATH=... external service log
# AGENT_TEAM_S6_SVC=s6-svc
# AGENT_TEAM_S6_SVSTAT=s6-svstat
# AGENT_TEAM_S6_SETUIDGID=s6-setuidgid

# Inference deployment. Replace with the model service used by this installation.
LLM_BASE_URL=http://model-service:8000/v1
# "auto" selects the sole model advertised by GET /models. Set an explicit ID
# when the endpoint advertises more than one model.
LLM_MODEL=auto
# Optional. When nonempty, this is sent as Bearer authentication to LLM_BASE_URL only.
LLM_API_KEY=
PRINCIPAL_MODEL=${LLM_MODEL}
MANAGER_MODEL=${LLM_MODEL}
WORKER_MODEL=${LLM_MODEL}
CURATOR_MODEL=${LLM_MODEL}

# Hermes plugin -> Agent Team API endpoint.
AGENT_TEAM_URL=http://localhost:8080
# Optional. Empty preserves anonymous local mode; nonempty enables Bearer auth
# for every Agent Team HTTP route and must also reach its control clients.
AGENT_TEAM_API_TOKEN=
# Kept empty because the plugin no longer routes by Matrix room.
AGENT_TEAM_PRINCIPAL_ROOM_ID=
